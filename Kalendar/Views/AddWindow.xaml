<Window x:Class="WpfCalendar.Views.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AddWindow" Height="250" Width="350">
    <StackPanel Margin="20">
        <DatePicker x:Name="DatePicker" Margin="0,0,0,15"/>
        <TextBlock Text="Введите событие" Margin="0,0,0,5"/>
        <TextBox x:Name="DescriptionBox" Height="40" Margin="0,0,0,15"/>
        <Button Content="Сохранить" Width="100" Click="SaveButton_Click"/>
    </StackPanel>
</Window>